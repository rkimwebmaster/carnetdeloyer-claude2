# Valeurs par défaut non secrètes. Les secrets de production vont dans .env.local
# ou dans les variables d'environnement du serveur (R-119).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_dev_secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_dev_passphrase
###< lexik/jwt-authentication-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://cdl:cdl@127.0.0.1:3306/cdl?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> carnetdeloyer ###
# Clé de chiffrement des téléphones et coordonnées GPS (R-124) : 32 octets en base64.
# Générer avec : php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_CHIFFREMENT_CLE=ZGV2LWNsZS1kZS1jaGlmZnJlbWVudC0zMi1vY3RldHM=
# Fournisseur SMS (R-77) : "log" écrit les SMS dans les journaux (dev uniquement).
APP_SMS_FOURNISSEUR=log
# API de conversion monétaire (R-69). Vide = aucune conversion distante.
APP_TAUX_CHANGE_URL=https://open.er-api.com/v6/latest/USD
# URL publique utilisée dans les liens de reçus (R-75).
APP_URL_PUBLIQUE=http://localhost:8000
###< carnetdeloyer ###
