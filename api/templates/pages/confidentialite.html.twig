    <style>
        body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #1d2433; background: #f5f6f8; line-height: 1.55; }
        main { max-width: 680px; margin: 24px auto; padding: 0 16px 32px; }
        h1 { font-size: 1.4rem; } h2 { font-size: 1.05rem; margin-top: 1.6em; }
